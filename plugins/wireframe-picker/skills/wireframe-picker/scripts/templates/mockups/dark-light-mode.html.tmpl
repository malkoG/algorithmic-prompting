<!--
  Dark/light mode mockup CANDIDATE (not the picker screen) — a realistic
  settings-style page rendered once per mode, so contrast/legibility
  across the surface hierarchy (page bg vs. card bg vs. border vs. body
  text vs. muted text) is actually visible, not just a flat background
  swap between two colors.

  Fill in {{MODE}} with exactly "dark" or "light" (lowercase) — it drives
  the body class `theme-{{MODE}}`, which selects the matching CSS custom
  property set below. Delete this comment before serving. Instantiate
  this template twice (once per mode) to get the two variants for the
  .split comparison.
-->
<!DOCTYPE html>
<html><head><meta charset="utf-8">
<style>
  :root {
    --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  body.theme-dark {
    --bg: #0e0e10;
    --fg: #eaeaea;
    --muted-fg: #9a9aa2;
    --card-bg: #19191c;
    --border: #2c2c31;
    --accent: #5b7cfa;
    --accent-fg: #ffffff;
  }
  body.theme-light {
    --bg: #f5f5f7;
    --fg: #1a1a1e;
    --muted-fg: #6b6b73;
    --card-bg: #ffffff;
    --border: #dcdce0;
    --accent: #3a5bd9;
    --accent-fg: #ffffff;
  }
  body {
    margin: 0;
    padding: 2rem;
    font-family: var(--font);
    background: var(--bg);
    color: var(--fg);
    max-width: 560px;
  }
  h1 { font-size: 1.6rem; margin: 0 0 0.25rem; font-weight: 700; }
  .page-subtitle { font-size: 0.95rem; color: var(--muted-fg); margin: 0 0 1.5rem; }
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
  }
  .card h2 { font-size: 1.1rem; margin: 0 0 0.6rem; font-weight: 600; }
  .card p { font-size: 0.92rem; line-height: 1.6; margin: 0 0 1.25rem; color: var(--fg); }
  .card .muted-line {
    font-size: 0.8rem;
    color: var(--muted-fg);
    margin: 0 0 1.25rem;
  }
  .btn {
    font-family: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    background: var(--accent);
    color: var(--accent-fg);
    border: none;
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    cursor: pointer;
  }
</style></head>
<body class="theme-{{MODE}}">
  <h1>Notification Settings</h1>
  <p class="page-subtitle">Manage how and when you hear from us</p>
  <div class="card">
    <h2>Email digests</h2>
    <p>Get a summary of activity across your workspace delivered every morning. You can adjust the send time or switch to a weekly cadence at any time.</p>
    <div class="muted-line">Last sent 3 hours ago &middot; 214 recipients</div>
    <button class="btn">Save changes</button>
  </div>
</body></html>
